# ====================================================
# Telegram Cinema Bot & WebApp Configuration
# ====================================================

# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# 2. Admin Telegram User IDs (comma separated, e.g. 12345678,98765432)
ADMIN_IDS=123456789

# 3. Card details for payment (Uzbek Sums & Cards)
CARD_NUMBER=8600 0000 0000 0000
CARD_BANK=Uzcard / Humo
CARD_HOLDER=Имя Получателя

# 4. Subscription settings
CURRENCY_SYMBOL=сум
SUBSCRIPTION_PRICE=25000
SUBSCRIPTION_DAYS=30

# 5. Cinema destination URL
CINEMA_URL=https://msx.zona.ms/

# 6. Persistent Cloud Database (Optional: PostgreSQL connection string from Supabase, Neon, or Render PostgreSQL)
# If left empty, will use local SQLite.
# Example: postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 7. WebApp and Anti-Sleep Settings
WEBAPP_URL=http://localhost:8000
KEEP_ALIVE=true
PING_INTERVAL=600
DATABASE_PATH=data/cinema_bot.db
HOST=0.0.0.0
PORT=8000
