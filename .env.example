# ====================================================
# Telegram Cinema Bot & WebApp Configuration
# ====================================================

# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# 2. Admin Telegram User IDs (comma separated, e.g. 12345678,98765432)
ADMIN_IDS=123456789

# 3. Card details for manual payment
CARD_NUMBER=2202 2000 0000 0000
CARD_BANK=Т-Банк / Сбербанк
CARD_HOLDER=Иван И.

# 4. Subscription settings
SUBSCRIPTION_PRICE=299
SUBSCRIPTION_DAYS=30

# 5. WebApp URL (Use ngrok or Cloudflare Tunnel during development, e.g. https://your-subdomain.ngrok-free.app)
# For local browser testing you can leave http://localhost:8000
WEBAPP_URL=http://localhost:8000

# 6. Database and Server
DATABASE_PATH=data/cinema_bot.db
HOST=0.0.0.0
PORT=8000
